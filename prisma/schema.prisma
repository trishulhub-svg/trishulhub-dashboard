// TODO: Convert to Prisma enums when feasible: UserRole, ProjectStatus, TaskStatus, TaskPriority,
// InvoiceStatus,
// LeadStatus, ClientStatus, ApprovalStatus,
// LeaveType, ExpenseCategory, SubscriptionFrequency, SubscriptionStatus,
// DealStage, Currency, PaymentMethod, NotificationType,
// ProjectMemberRole, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ━━ User & Auth ━━
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("DEVELOPER") // SUPER_ADMIN, ADMIN, DEVELOPER, VIEWER, CLIENT
  department    String?  // MANAGEMENT, ENGINEERING, DESIGN, MARKETING, SALES, FINANCE, OPERATIONS, DEV, HR, CONTENT, SUPPORT
  avatar        String?
  isActive      Boolean  @default(true)
  // Page access ACL — OFF | ALLOW | RESTRICT (only one mode active; see nav-pages.ts)
  pageAccessMode  String  @default("OFF")
  pageAccessPages String  @default("[]") // JSON string[] of /dashboard/... hrefs
  favoritePages   String  @default("[]") // JSON string[] up to 2 favorite /dashboard/... hrefs
  // Docx Sign — saved Authorized Person signature (Admin / Super Admin)
  docxAuthorizedSignature String?
  // Docx Sign — saved acceptor signature (any user who signed a contract)
  docxAcceptorSignature String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sentInvoices       Invoice[]
  attendanceRecords  Attendance[]
  notifications      Notification[]
  approvalActions    Approval[]       @relation("ApprovalActions")
  timeEntries        TimeEntry[]
  projectMemberships ProjectMember[]
  milestoneAssignments ProjectMilestoneAssignee[]
  emailVerifications EmailVerification[]
  passwordChanges    PasswordChange[]
  passwordResets     PasswordReset[]
  activeSession      ActiveSession?
  leaves                Leave[]
  approvedLeaves        Leave[]               @relation("ApprovedLeaves")
  availabilities           Availability[]
  availabilityOverrides    AvailabilityOverride[]
  availabilityDateRanges   AvailabilityDateRange[]
  assignedDeals         Deal[]
  expenses                Expense[]             @relation("ExpenseEmployee")
  userCredentials     UserCredential[]
  linkedClients        Client[]            @relation("ClientLinkedUser")
  notificationPreferences NotificationPreference?
  userDetail         UserDetail?
  trainingQrs        TrainingQr[]
  trainingQrRequests TrainingQrRequest[]
  trainingAssignmentsAssigned TrainingAssignment[] @relation("TrainingAssignmentAssignee")
  trainingAssignmentsCreated  TrainingAssignment[] @relation("TrainingAssignmentAssigner")
  leaveBalances               LeaveBalance[]
  docxDocumentsUploaded       DocxDocument[]       @relation("DocxDocumentUploader")
  docxAssignmentsAssigned     DocxAssignment[]     @relation("DocxAssignmentAssignee")
  docxAssignmentsCreated      DocxAssignment[]     @relation("DocxAssignmentAssigner")
  teamSupportTickets          TeamSupportTicket[]  @relation("TeamSupportTicketRaiser")

  @@map("User")
}

// ━━ Docx Sign — e-signature contracts (Admin / Super Admin upload + assign) ━━
model DocxDocument {
  id           String   @id @default(cuid())
  title        String
  fileName     String
  mimeType     String   @default("application/pdf")
  // data:application/pdf;base64,... (source unsigned PDF)
  fileData     String
  uploadedById String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy  User             @relation("DocxDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  assignments DocxAssignment[]

  @@index([isActive, createdAt])
  @@map("DocxDocument")
}

model DocxAssignment {
  id              String    @id @default(cuid())
  documentId      String
  userId          String
  // PENDING | SIGNED | RESIGN_REQUESTED
  status          String    @default("PENDING")
  assignedById    String
  // Snapshot of Authorized Person (assigner) at assign time
  authorizedPersonName    String?
  authorizedSignatureData String?
  // PNG data URL of acceptor (signer) signature
  signatureData   String?
  signedAt        DateTime?
  // Stamped PDF after sign (data:application/pdf;base64,...)
  signedFileData  String?
  signerIp        String?
  signerUserAgent String?
  signerCountry   String?
  signerTimeZone  String?
  resignNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  document   DocxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User         @relation("DocxAssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User         @relation("DocxAssignmentAssigner", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([documentId, status])
  @@index([status, createdAt])
  @@index([documentId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@map("DocxAssignment")
}

// ━━ Learning / Percipio training QR (SuperAdmin managed) ━━
model TrainingQr {
  id           String   @id @default(cuid())
  imageData    String   // data:image/...;base64,...
  mimeType     String   @default("image/png")
  uploadedById String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User               @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  requests   TrainingQrRequest[]

  @@index([isActive, createdAt])
  @@map("TrainingQr")
}

model TrainingQrRequest {
  id              String    @id @default(cuid())
  userId          String
  status          String    @default("PENDING") // PENDING, FULFILLED
  note            String?
  createdAt       DateTime  @default(now())
  fulfilledAt     DateTime?
  fulfilledByQrId String?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfilledByQr TrainingQr? @relation(fields: [fulfilledByQrId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("TrainingQrRequest")
}

// Assigned Percipio training items (admin-managed, due-date tracked)
model TrainingAssignment {
  id               String    @id @default(cuid())
  userId           String
  title            String
  notes            String?
  dueDate          DateTime
  status           String    @default("ASSIGNED") // ASSIGNED, DONE
  assignedById     String
  completedAt      DateTime?
  overdueNotifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User @relation("TrainingAssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("TrainingAssignmentAssigner", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([dueDate, status])
  @@index([status])
  @@map("TrainingAssignment")
}

// ━━ Encrypted secret vault (generic API keys / credentials storage) ━━
model VaultSecret {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("OTHER") // BREVO, OPENROUTER, ZAI, SMTP, GOOGLE_AI, NVIDIA, OTHER
  keyValue  String   // encrypted via encryptToJson
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("VaultSecret")
}
// ━━ Approval System ━━
model Approval {
  id             String   @id @default(cuid())
  type           String   // TASK, INVOICE, EMAIL, QUOTATION, PROJECT_PLAN, CODE_REVIEW, LEAD_OUTREACH, CONTENT_PIECE, EXPENSE_APPROVAL, ...
  requesterType  String   // AI, HUMAN
  requesterId    String?  // userId
  title          String
  description    String?  // Summary of what needs approval
  data           String   @default("{}") // JSON: the item needing approval
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_IMPROVEMENT
  feedback       String?  // Why rejected or what to improve
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  approvedBy  User?   @relation("ApprovalActions", fields: [approvedById], references: [id])

  @@index([status])
  @@index([requesterType])
  @@index([requesterId, status])
  @@map("Approval")
}

// ━━ Project Method ━━
// NOTE: Project ↔ ProjectMethod many-to-many is handled via raw SQL
// on the _ProjectMethodToProject join table (see auto-migrate.ts).
// We do NOT use Prisma's implicit many-to-many because it caused
// build OOM on Vercel and added unnecessary type complexity.
model ProjectMethod {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]  @relation("ClientProjectMethod")
}

// ━━ Clients ━━
model Client {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String?
  company         String?
  website         String?              // kept for backward compat
  websites        ClientWebsite[]
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, ONBOARDING, PAUSED, COMPLETED, CHURNED
  userId          String?  // linked portal user
  user            User?    @relation("ClientLinkedUser", fields: [userId], references: [id])
  notes           String?
  projectType     String?              // ENGINEERING, MEDICAL, RETAIL, REAL_ESTATE, FINANCE, EDUCATION, LEGAL, FOOD_BEVERAGE, MANUFACTURING, IT_SERVICES, OTHER
  projectMethodId String?              // Method of Project (JAVA, PHP, HTML, Other, etc.)
  projectStartDate DateTime?            // When engagement started
  deliveryDate    DateTime?            // Expected delivery date
  mediatorName    String?              // Mediator/agent/broker name
  mediatorPhone   String?              // Mediator contact number
  mediatorEmail   String?              // Mediator email
  contractUrl     String?              // External contract link (paste URL; replaces old generated contracts)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projects       Project[]
  invoices       Invoice[]
  leads          Lead[]
  deals          Deal[]
  contacts       Contact[]
  tickets        SupportTicket[]
  projectMethod  ProjectMethod?  @relation("ClientProjectMethod", fields: [projectMethodId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([email])
}

// ━━ Client Websites (one-to-many) ━━
model ClientWebsite {
  id        String   @id @default(cuid())
  url       String
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  clientId  String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ━━ Projects ━━
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  clientId    String?
  status      String   @default("PLANNING") // PLANNING, IN_PROGRESS, REVIEW, APPROVAL, DEPLOYED, COMPLETED
  progress    Int      @default(0) // 0-100 (validated at application level)
  isDemo      Boolean  @default(false) // Demo projects appear on /dashboard/demo with a DEMO badge
  // TODO: Add unique constraint on name or composite @@unique([name, clientId]) after data cleanup
  startDate   DateTime?
  deadline    DateTime?
  budget      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client       Client?       @relation(fields: [clientId], references: [id])
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  expenses     Expense[]
  subscriptions Subscription[]
  members      ProjectMember[]
  credentials  ProjectCredential[]
  websites     ProjectWebsite[]
  infrastructure ProjectInfrastructure?
  infraItems     ProjectInfraItem[]
  infraMemberAccess ProjectInfraMemberAccess[]
  milestones   ProjectMilestone[]
  // methods are fetched via raw SQL on _ProjectMethodToProject join table

  @@index([clientId])
  @@index([status])
  @@index([deadline])
}

// ━━ Project Infrastructure (repo URL, GitHub token, Turso URL, Turso token) ━━
// Stores deployment/infrastructure metadata for each project.
// Tokens are AES-256-GCM encrypted at rest using the credential encryption key.
model ProjectInfrastructure {
  id              String   @id @default(cuid())
  projectId       String   @unique

  // Non-secret fields (visible to assigned members)
  githubRepoUrl   String?  // e.g., "trishulhub-svg/trishulhub-dashboard.git"
  githubBranch    String?  // default branch, e.g., "main"
  tursoUrl        String?  // e.g., "libsql://xxx.turso.io"
  vercelProjectId String?
  deployUrl       String?  // e.g., "https://trishulhub-dashboard.vercel.app"

  // Secret fields (AES-256-GCM encrypted, revealed only via dedicated endpoint)
  githubTokenEnc  String?  // base64-encoded ciphertext
  githubTokenIv   String?  // base64-encoded IV
  githubTokenTag  String?  // base64-encoded auth tag
  tursoTokenEnc   String?  // base64-encoded ciphertext
  tursoTokenIv    String?  // base64-encoded IV
  tursoTokenTag   String?  // base64-encoded auth tag

  updatedBy       String?  // userId of last editor
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ━━ Project Infrastructure Items (grouped secrets/config) ━━
model ProjectInfraItem {
  id          String   @id @default(cuid())
  projectId   String
  groupKey    String   // GITHUB | TURSO | CLOUDFLARE | SMTP | CUSTOM_*
  // Display name for custom groups (null for built-ins)
  groupLabel  String?
  label       String
  isSecret    Boolean  @default(true)
  // Non-secret plain value OR encrypted envelope JSON for secrets
  valuePlain  String?
  valueEnc    String?
  sortOrder   Int      @default(0)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, groupKey])
  @@map("ProjectInfraItem")
}

// Timed per-user visibility grants (PM/Admin selects who can view infra secrets)
model ProjectInfraMemberAccess {
  id           String    @id @default(cuid())
  projectId    String
  userId       String
  visibleUntil DateTime?
  enabledBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("ProjectInfraMemberAccess")
}

// ━━ Project Websites (live URLs for each project) ━━
model ProjectWebsite {
  id        String   @id @default(cuid())
  url       String
  label     String?  // e.g., "Production", "Staging", "Dev"
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ━━ Project Members (RBAC) ━━
model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("MEMBER") // MEMBER, LEAD
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ━━ Invoices ━━
// TODO: Convert these String fields to Prisma enums for DB-level validation:
// InvoiceStatus, PaymentStatus, PaymentMethod, ExpenseCategory, SubscriptionFrequency, SubscriptionStatus,
// DealStage, ContractStatus, Currency
//
// TODO: Create InvoiceItem model for proper line-item tracking instead of JSON blob
// Proposed: model InvoiceItem { id String @id @default(cuid()) invoiceId String invoice Invoice @relation(...) description String quantity Int rate Float amount Float }
// TODO: Create ExchangeRate model for proper currency tracking:
// model ExchangeRate { id String @id @default(cuid()) fromCurrency String toCurrency String rate Float effectiveDate DateTime @@unique([fromCurrency, toCurrency, effectiveDate]) }
model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String?
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("Payment")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  clientId      String
  projectId     String?
  // TODO: Create InvoiceItem model for proper line-item tracking instead of JSON blob
  items         String   @default("[]") // JSON array of line items — TODO: migrate to InvoiceItem model
  // NOTE: Cross-validation (total === subtotal + tax + gst) is enforced at application level in Zod schemas
  // TODO: Add DB trigger for financial field integrity
  subtotal      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  currency      String   @default("INR") // INR, USD, GBP, EUR — company default INR
  status        String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMethod  String?   // UPI, CREDIT_DEBIT_CARD, BANK_TRANSFER, OTHER
  gst            Float?    // GST amount in INR
  gstPercent     Float?    // GST percentage (e.g., 18)
  notes          String?   // Additional notes
  paymentStatus  String    @default("UNPAID") // PAID, UNPAID, DUE

  sentBy        User?    @relation(fields: [sentById], references: [id])
  sentById      String?
  payments      Payment[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([status])
  @@index([paymentStatus])
  @@map("Invoice")
}

// ━━ CRM / Leads ━━
model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  company     String?
  website     String?
  phone       String?
  // TODO: Convert source to Prisma enum when feasible
  source      String   @default("MANUAL") // MANUAL, AI_FOUND, REFERRAL, SOCIAL_MEDIA
  score       Int      @default(0)
  // TODO: Convert status to Prisma enum when feasible
  status      String   @default("NEW") // NEW, CONTACTED, INTERESTED, PROPOSAL, NEGOTIATING, WON, LOST
  notes       String?
  clientId    String?  // converted to client
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client?  @relation(fields: [clientId], references: [id])
  emails      LeadEmail[]
  deals       Deal[]
  contacts    Contact[]

  @@index([status])
  @@index([clientId])
}

model LeadEmail {
  id        String   @id @default(cuid())
  leadId    String
  subject   String
  body      String
  direction String   @default("OUTBOUND") // OUTBOUND, INBOUND
  status    String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, SENT, FAILED
  sentAt    DateTime?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ━━ CRM Deals ━━
model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Float     @default(0)
  currency          String    @default("INR") // USD, GBP, INR
  stage             String    @default("LEAD") // LEAD, QUALIFIED, PROPOSAL, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  probability       Int       @default(0) // 0-100
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  clientId          String?
  leadId            String?
  assignedToId      String?   // userId of the assigned team member
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // TODO: Convert stage, currency to Prisma enums when feasible
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation(fields: [assignedToId], references: [id])

  @@index([stage])
  @@index([clientId])
  @@index([leadId])
  @@index([expectedCloseDate])
  @@index([assignedToId])

  @@map("Deal")
}

// ━━ CRM Contacts ━━
model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String   @unique
  phone     String?
  jobTitle  String?
  clientId  String?
  leadId    String?
  notes     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO: Convert jobTitle to Prisma enum when feasible
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([leadId])

  @@map("Contact")
}

// ━━ Support Tickets ━━
model SupportTicket {
  id          String   @id @default(cuid())
  clientId    String
  // Human-readable ticket number e.g. TH-240730-0001 (optional for legacy rows)
  ticketNumber String?
  issueArea   String?  // e.g. Billing, Portal, Technical
  subject     String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedTo  String?  // userId
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // TODO: Convert status, priority to Prisma enums when feasible
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  messages    TicketMessage[]

  @@index([assignedTo])
  @@index([priority])
  @@index([clientId, status])
  @@index([ticketNumber])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String?  // userId or null for AI
  // TODO: Convert senderType to Prisma enum when feasible
  senderType String  @default("HUMAN") // HUMAN, AI
  message   String
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ━━ Team (staff) support tickets — employees raise issues; Admin/SA resolve ━━
model TeamSupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  userId       String
  issueArea    String
  subject      String
  description  String
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String   @default("MEDIUM")
  resolution   String?
  assignedTo   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                   @relation("TeamSupportTicketRaiser", fields: [userId], references: [id], onDelete: Cascade)
  messages TeamSupportMessage[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([ticketNumber])
  @@map("TeamSupportTicket")
}

model TeamSupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?
  senderType String   @default("HUMAN") // HUMAN, STAFF, SYSTEM
  message    String
  createdAt  DateTime @default(now())

  ticket TeamSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("TeamSupportMessage")
}

// ━━ Time Tracking ━━
model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  description String?
  // Optional at clock-out; editable by owner for 24h after clockOut, then locked
  workNotes   String?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED
  clockIn     DateTime @default(now())
  clockOut    DateTime?
  totalHours  Float?   // Computed on clock out: (clockOut - clockIn) in hours
  date        DateTime @default(now()) // The date this entry belongs to (for grouping)

  // ── Agent attendance tracking (Phase A3) ──
  // Source of the entry — MANUAL (legacy/admin), AGENT_OTP (auto from OTP login), ADMIN_OVERRIDE
  source         String   @default("MANUAL") // MANUAL, AGENT_OTP, ADMIN_OVERRIDE
  // Links to the agent JWT session ID (jti) — useful for tying a TimeEntry to a specific auth session
  agentSessionId String?
  // How the user clocked in: OTP, MANUAL, ADMIN
  clockInMethod  String?
  // How the user clocked out: END_COMMAND, MANUAL, ADMIN_OVERRIDE, AUTO_MISSED
  clockOutMethod String?
  // PROJECT | TRAINING | HR_ADMIN | RD_SA
  activityType   String?
  // When activityType=TRAINING, optional TrainingAssignment id
  trainingAssignmentId String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, status])
  @@index([projectId])
  @@index([date])
  @@index([agentSessionId])
  @@index([source])

  @@map("TimeEntry")
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, status])
  @@map("Attendance")
}

// ━━ Notifications ━━
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS, TASK, APPROVAL
  isRead    Boolean  @default(false)
  link      String?
  metadata  String?  // JSON: additional data (taskId, approvalId, etc.)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([isRead])
}

// ━━ Notification Preferences (per-user) ━━
model NotificationPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  emailNotifications   Boolean @default(true)
  budgetAlerts         Boolean @default(true)
  meetingReminders     Boolean @default(true)
  taskReminders        Boolean @default(true)
  approvalAlerts       Boolean @default(true)
  invoiceReminders     Boolean @default(true)
  quietHoursEnabled    Boolean @default(false)
  quietHoursStart      String? // "22:00"
  quietHoursEnd        String? // "08:00"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ━━ Expense categories (admin-managed; Expense.category stores the name key) ━━
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. HOSTING, API_COSTS, CLOUD_HOSTING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ExpenseCategory")
}

// ━━ Expenses ━━
model Expense {
  id          String   @id @default(cuid())
  category    String   // matches ExpenseCategory.name
  description String
  // amount >= 0 enforced at application level; round via lib/money
  amount      Float    @default(0)
  currency    String   @default("INR") // INR, USD, GBP, EUR
  date        DateTime
  receiptUrl  String?
  projectId   String?
  employeeId   String?   // Employee associated with this expense (for salary tracking)
  paymentRef   String?   // Payment reference number / transaction ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee    User?    @relation("ExpenseEmployee", fields: [employeeId], references: [id])

  @@index([projectId])
  @@index([category])
  @@index([date])
  @@index([employeeId])

  @@map("Expense")
}

// ━━ Subscriptions ━━
model Subscription {
  id           String    @id @default(cuid())
  service      String    // Service name e.g., "ChatGPT Subscription"
  amount       Float     @default(0) // Actual cost in the selected currency
  currency     String    @default("INR") // INR, GBP, USD
  exchangeRate Float     @default(1) // Conversion rate to INR (1 for INR, ~105.5 for GBP, ~83.5 for USD)
  frequency    String    @default("MONTHLY") // MONTHLY, YEARLY, ONE_TIME
  status       String    @default("ACTIVE") // ACTIVE, STOPPED, COMPLETED
  category     String?   // Software, Hosting, etc.
  projectId    String?
  startDate    DateTime  @default(now())
  endDate      DateTime? // When subscription ends/stopped
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([service])

  @@map("Subscription")
}

// ━━ SMTP Configuration ━━
model SmtpConfig {
  id          String   @id @default(cuid())
  host        String   // e.g., smtp-relay.brevo.com
  port        Int      @default(587)
  username    String   // SMTP login
  password    String   // SMTP password (stored encrypted in DB)
  fromEmail   String   // Sender email address
  fromName    String   @default("TrishulHub") // Sender display name
  secure      Boolean  @default(false) // Use TLS (true for port 465)
  isPrimary   Boolean  @default(true) // Primary or failover
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ━━ Email Verification (OTP) ━━
model EmailVerification {
  id         String   @id @default(cuid())
  userId     String
  newEmail   String   // The new email the user wants to switch to
  otp        String   // Bcrypt-hashed OTP code (never stored in plaintext)
  verified   Boolean  @default(false)
  attempts   Int      @default(0) // Failed verification attempts
  expiresAt  DateTime // OTP expiry (10 minutes)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

// ━━ Email Log (Audit Trail) ━━
model EmailLog {
  id            String   @id @default(cuid())
  to            String   // Recipient email
  subject       String   // Email subject
  type          String   // OTP, PASSWORD_CHANGE, EMAIL_CHANGE, RESET_LINK, DIRECT_RESET
  status        String   // SENT, FAILED, REJECTED
  smtpConfigId  String?  // Which SMTP config was used
  smtpHost      String?  // SMTP host for quick reference
  method        String?  // primary, failover
  error         String?  // Error message if failed
  triggeredBy   String?  // userId who triggered the email
  metadata      String?  // JSON: additional context
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([triggeredBy])
}

// ━━ Password Change (OTP verification) ━━
model PasswordChange {
  id         String   @id @default(cuid())
  userId     String
  otp        String   // Bcrypt-hashed OTP code
  verified   Boolean  @default(false)
  attempts   Int      @default(0)
  expiresAt  DateTime // OTP expiry (10 minutes)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ━━ Password Reset Token ━━
model PasswordReset {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique // Secure random token for reset link
  used       Boolean  @default(false)
  expiresAt  DateTime // Token expiry (1 hour)
  triggeredBy String? // SUPER_ADMIN userId who initiated the reset
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// ━━ Active Session (Single-Device Login Enforcement) ━━
model ActiveSession {
  id           String   @id @default(cuid())
  userId       String   @unique // One active session per user
  sessionToken String   // Current valid session token (UUID)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
}

// TODO: Phase 7 — Missing HR fields on User model:
// joinDate DateTime?, designation String?, employeeCode String @unique?, 
// phone String?, dateOfBirth DateTime?, managerId String? (self-ref), salaryBand String?

// ━━ Leave Management (Enhanced) ━━
model Leave {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   String   // SICK_LEAVE, CASUAL_LEAVE, ANNUAL_LEAVE, PUBLIC_HOLIDAY, OTHER
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedBy  String?
  approver    User?    @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  feedback    String?  // Admin note on approve/reject
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // TODO: Phase 7 — Add leave balance validation. Currently leave can be approved
  // without checking remaining balance. Implement LeaveBalance model and validate
  // in leave approval endpoints.

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("Leave")
}

model LeaveBalance {
  id        String @id @default(cuid())
  userId    String
  year      Int
  allowance Int    @default(12)
  used      Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("LeaveBalance")
}

model ProjectMilestone {
  id              String    @id @default(cuid())
  projectId       String
  title           String
  description     String?
  done            Boolean   @default(false)
  sortOrder       Int       @default(0)
  dueDate         DateTime?
  // Optional UK clock time HH:mm — with dueDate, overdue when both pass (Europe/London)
  dueTime         String?
  // Once carried forward at clock-out; blocks another carry until done
  carriedForward  Boolean   @default(false)
  dueNotifiedAt   DateTime?
  createdById     String?
  completedAt     DateTime?
  completedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project   Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees ProjectMilestoneAssignee[]

  @@index([projectId])
  @@index([dueDate])
  @@index([done])
  @@index([dueNotifiedAt])
  @@map("ProjectMilestone")
}

model ProjectMilestoneAssignee {
  id          String   @id @default(cuid())
  milestoneId String
  userId      String
  assignedAt  DateTime @default(now())

  milestone ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, userId])
  @@index([userId])
  @@index([milestoneId])
  @@map("ProjectMilestoneAssignee")
}

// ━━ Employee Availability ━━
model Availability {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime, endTime])
  @@index([userId])
  @@index([userId, dayOfWeek])
  @@map("Availability")
}

// ━━ Availability Overrides ━━
model AvailabilityOverride {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime // Specific date
  startTime   String?  // HH:mm format, null = all day
  endTime     String?  // HH:mm format, null = all day
  isAvailable Boolean
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@unique([userId, date])
  @@index([userId, date])
  @@map("AvailabilityOverride")
}

// ━━ Availability Date Ranges ━━
// Spans multiple consecutive dates (e.g., "Available June 20–25, 9am–5pm"
// or "On vacation July 1–14"). Additive to the weekly recurring schedule.
model AvailabilityDateRange {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime // Start of date range (inclusive)
  endDate     DateTime // End of date range (inclusive)
  startTime   String?  // HH:mm format, null = all day
  endTime     String?  // HH:mm format, null = all day
  isAvailable Boolean  @default(true) // true = available, false = unavailable (leave/vacation)
  reason      String?  // Optional reason/note
  // JSON array of weekdays 0=Sun…6=Sat; null/empty = all days in the span
  daysOfWeek  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@map("AvailabilityDateRange")
}
// ━━ Project Credentials (encrypted ID/password storage) ━━
model ProjectCredential {
  id        String   @id @default(cuid())
  projectId String
  title     String   // e.g., "Hosting Login", "Client Portal", "Database"
  username  String
  password  String   // encrypted with AES-256-GCM
  iv        String   // initialization vector (base64)
  tag       String   // auth tag (base64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ━━ User Credentials (ID & Password Management) ━━
model UserCredential {
  id          String   @id @default(cuid())
  userId      String
  label       String   // e.g., "Workspace", "Email", "Portal", "Hosting"
  username    String   // The ID / username
  password    String   // The password / secret
  url         String?  // Optional login URL
  notes       String?  // Additional instructions
  createdBy   String?  // SUPER_ADMIN userId who created it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ━━ User Details (HR & People — country, gov ID, bank account) ━━
// Each user has at most one UserDetail row (one-to-one with User).
// Country selection is one-time: once countryLocked is true, only an admin can change it.
// Sensitive fields (govIdNumber, bankAccountNumber) are encrypted at rest using
// encryptCredentialToJson() — the JSON envelope {"enc","iv","tag"} is stored in a
// single column. The separate iv/tag columns are reserved for future migration.
model UserDetail {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Country selection (one-time, locked after set)
  country         String?  // "UK" or "INDIA"
  countryLocked   Boolean  @default(false) // Once set, only admin can change

  // Personal info
  fullNameAsPerId String?  // Full name as per government document

  // Government ID
  govIdType       String?  // "AADHAAR", "PAN", "NI"
  govIdNumber     String?  // The ID number (encrypted at rest — JSON envelope)
  govIdEncIv      String?  // IV for encryption (reserved for future migration)
  govIdEncTag     String?  // Auth tag for encryption (reserved for future migration)

  // Bank details
  bankAccountName String?   // Account holder name
  bankAccountNumber String? // Account number (encrypted — JSON envelope)
  bankAccountEncIv String?  // Reserved for future migration
  bankAccountEncTag String? // Reserved for future migration
  bankSortCode    String?  // UK: sort code, India: IFSC code
  bankName        String?  // Bank name
  bankBranch      String?  // Branch name (India)

  // Status (review workflow)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectedReason  String?  // If rejected, why
  reviewedBy      String?  // Admin who reviewed
  reviewedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([country])
}

// ━━ Audit Log (Department-Wise) ━━
// Standalone table — no relation to User (too many records, would slow down User queries).
// All writes are fire-and-forget (non-blocking) to never slow down API responses.
model AuditLog {
  id             String   @id @default(cuid())
  userId         String
  userName       String
  userRole       String   // SUPER_ADMIN, ADMIN, DEVELOPER, VIEWER, CLIENT
  userDepartment String?  // from DEPARTMENTS values
  department     String   // BUSINESS, TEAM_WORK, HR_PEOPLE, LEARNING, SYSTEM
  page           String   // e.g., "invoices", "projects", "leaves"
  action         String   // CREATE, READ, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT, APPROVE, REJECT, SEND, ASSIGN, etc.
  entityType     String?  // e.g., "Invoice", "Client", "Project", "Task"
  entityId       String?
  description     String   // human-readable description
  oldValue       String?  // JSON string of previous state (for UPDATE)
  newValue       String?  // JSON string of new state (for UPDATE/CREATE)
  ipAddress      String?
  userAgent      String?
  status         String   @default("SUCCESS") // SUCCESS, FAILURE
  metadata       String?  // JSON string for extra context
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([department])
  @@index([page])
  @@index([action])
  @@index([entityId])
  @@index([createdAt])
  @@index([department, page])
  @@index([department, action])
  @@index([userId, createdAt])
}

// ━━ System Settings ━━
model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

