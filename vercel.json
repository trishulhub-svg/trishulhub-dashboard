{
  "functions": {
    "src/app/api/task-git-sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/execute-tasks/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/execute-tasks",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/execute-tasks",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/execute-tasks",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/execute-tasks",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/execute-tasks",
      "schedule": "0 5 * * *"
    }
  ]
}
